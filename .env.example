# Copy to `.env` for `npm run dev` (the Node dev server). For the Cloudflare
# runtime preview (`npm run build && npx wrangler dev`) use `.dev.vars` instead —
# see `.dev.vars.example`. Production values go in the Cloudflare Workers project
# under Settings -> Variables and Secrets.

# --- Stripe (checkout) ---
# Without this, the site still works: "Add to cart" works and Checkout shows an
# "email us to order" fallback. Add a TEST key (sk_test_...) to try real checkout.
STRIPE_SECRET_KEY=

# Public base URL, used to build Stripe success/cancel redirect URLs.
PUBLIC_SITE_URL=http://localhost:4321

# --- Keystatic ---
# Storage mode is automatic: `npm run dev` = local (edits write to files here),
# production build = GitHub mode (repo is set in keystatic.config.ts).
#
# The vars below are only needed in PRODUCTION (set them as secrets in the
# Cloudflare Workers project). Keystatic generates the client ID/secret for you
# when you first open /keystatic on the live site and connect the GitHub App —
# see HANDOFF.md §4.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
