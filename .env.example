# Copy to `.env` for local dev. Real values go in the Netlify dashboard for production.

# --- Stripe (checkout) ---
# Without this, the site still works: "Add to cart" works and Checkout shows an
# "email us to order" fallback. Add a TEST key (sk_test_...) to try real checkout locally.
STRIPE_SECRET_KEY=

# Public base URL, used to build Stripe success/cancel redirect URLs.
PUBLIC_SITE_URL=http://localhost:4321

# --- Keystatic storage ---
# "local" (default) writes CMS edits straight to files on disk — use for local dev.
# "github" is for production so Isaac can log in at /keystatic and commit edits.
KEYSTATIC_STORAGE_KIND=local

# Only needed when KEYSTATIC_STORAGE_KIND=github (see HANDOFF.md):
KEYSTATIC_GITHUB_REPO=owner/saucy-fields
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
