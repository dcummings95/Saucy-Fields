# Copy to `.env` for local dev. Real values go in the Netlify dashboard for production.

# --- Stripe (checkout) ---
# Without this, the site still works: "Add to cart" works and Checkout shows an
# "email us to order" fallback. Add a TEST key (sk_test_...) to try real checkout locally.
STRIPE_SECRET_KEY=

# Public base URL, used to build Stripe success/cancel redirect URLs.
PUBLIC_SITE_URL=http://localhost:4321

# --- Keystatic ---
# Storage mode is automatic: `astro dev` = local (edits write to files here),
# production build = GitHub mode (repo is set in keystatic.config.ts).
#
# The vars below are only needed in PRODUCTION (set them in Netlify). Keystatic
# generates the client ID/secret for you when you first open /keystatic on the
# live site and connect the GitHub App — see HANDOFF.md.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
