---
interface Props {
  settings: { email: string; shippingFlatRate: number; shippingNote: string };
}
const { settings } = Astro.props;
---

<div class="cart" data-cart hidden>
  <button class="cart__scrim" data-close-cart aria-label="Close cart"></button>
  <aside class="cart__panel" role="dialog" aria-modal="true" aria-label="Your cart">
    <header class="cart__head">
      <h2>Your cart</h2>
      <button class="cart__x" data-close-cart aria-label="Close cart">✕</button>
    </header>

    <div class="cart__body" data-cart-body>
      <!-- filled by script -->
    </div>

    <footer class="cart__foot" data-cart-foot hidden>
      <div class="cart__row">
        <span>Subtotal</span>
        <span data-cart-subtotal>$0.00</span>
      </div>
      <p class="cart__note">Shipping calculated at checkout. {settings.shippingNote}</p>
      <button class="btn btn--primary btn--block" data-checkout>Checkout</button>
      <p class="cart__fallback" data-cart-fallback hidden></p>
      <button class="cart__clear" data-clear-cart>Empty cart</button>
    </footer>
  </aside>
</div>

<style>
  .cart[hidden] { display: none; }
  .cart {
    position: fixed;
    inset: 0;
    z-index: 150;
    display: grid;
    grid-template-columns: 1fr min(26rem, 92vw);
  }
  .cart__scrim { border: 0; background: rgba(23, 21, 18, 0.45); cursor: pointer; }
  .cart__panel {
    background: var(--paper);
    border-left: 2.5px solid var(--ink);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: cart-in 0.18s ease-out;
  }
  @keyframes cart-in { from { transform: translateX(100%); } to { transform: translateX(0); } }

  .cart__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.2rem;
    border-bottom: 2.5px solid var(--ink);
  }
  .cart__head h2 { margin: 0; font-size: 1.5rem; }
  .cart__x { background: none; border: 0; font-size: 1.2rem; cursor: pointer; padding: 0.3rem; }

  .cart__body { flex: 1; overflow-y: auto; padding: 1rem 1.2rem; }
  .cart__empty { text-align: center; color: var(--ink); opacity: 0.7; margin-top: 2rem; }

  .cart-line { display: grid; grid-template-columns: 64px 1fr auto; gap: 0.8rem; padding-block: 0.9rem; border-bottom: 2px solid var(--paper-2); }
  .cart-line__img { width: 64px; height: 64px; object-fit: cover; border: 2px solid var(--ink); border-radius: 4px; background: var(--paper-2); }
  .cart-line__name { font-family: var(--font-display); font-weight: 700; line-height: 1.15; }
  .cart-line__opts { font-size: 0.85rem; opacity: 0.75; }
  .cart-line__qty { display: inline-flex; align-items: center; gap: 0.35rem; margin-top: 0.4rem; }
  .cart-line__qty button { width: 1.6rem; height: 1.6rem; border: 2px solid var(--ink); background: var(--paper); border-radius: 4px; cursor: pointer; font-weight: 700; line-height: 1; }
  .cart-line__price { font-family: var(--font-display); font-weight: 700; text-align: right; }
  .cart-line__remove { display: block; margin-top: 0.4rem; font-size: 0.78rem; background: none; border: 0; text-decoration: underline; cursor: pointer; color: var(--saucy-dark); }

  .cart__foot { padding: 1rem 1.2rem 1.3rem; border-top: 2.5px solid var(--ink); }
  .cart__foot[hidden] { display: none; }
  .cart__row { display: flex; justify-content: space-between; font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; }
  .cart__note { font-size: 0.8rem; opacity: 0.75; margin: 0.5rem 0 0.9rem; }
  .cart__fallback { font-size: 0.9rem; margin-top: 0.8rem; padding: 0.7rem; border: 2px dashed var(--ink); border-radius: 4px; background: var(--mustard); }
  .cart__fallback[hidden] { display: none; }
  .cart__clear { display: block; margin: 0.9rem auto 0; background: none; border: 0; font-size: 0.8rem; text-decoration: underline; cursor: pointer; }
</style>

<script is:inline define:vars={{ email: settings.email }}>
  window.__SAUCY_EMAIL__ = email;
</script>

<script>
  import { getCart, onCartChange, setQty, removeLine, clearCart, cartCount, cartSubtotal, lineKey } from '../lib/cart';
  import { usd } from '../lib/format';

  const root = document.querySelector('[data-cart]');
  const body = document.querySelector('[data-cart-body]');
  const foot = document.querySelector('[data-cart-foot]');
  const subtotalEl = document.querySelector('[data-cart-subtotal]');
  const fallbackEl = document.querySelector('[data-cart-fallback]');
  const checkoutBtn = document.querySelector('[data-checkout]');
  const email = window.__SAUCY_EMAIL__ || '';

  function open() { root?.removeAttribute('hidden'); document.body.style.overflow = 'hidden'; render(); }
  function close() { root?.setAttribute('hidden', ''); document.body.style.overflow = ''; }

  function render() {
    const lines = getCart();
    // header counts everywhere
    document.querySelectorAll('[data-cart-count]').forEach((el) => {
      el.textContent = String(cartCount());
      el.toggleAttribute('data-empty', cartCount() === 0);
    });

    if (!body) return;
    if (lines.length === 0) {
      body.innerHTML = '<p class="cart__empty">Nothing in the cart yet.<br>Go find something good.</p>';
      foot?.setAttribute('hidden', '');
      return;
    }
    foot?.removeAttribute('hidden');
    body.innerHTML = lines
      .map((l) => {
        const key = lineKey(l);
        const opts = [l.size, l.color].filter(Boolean).join(' · ');
        return `
          <div class="cart-line">
            <img class="cart-line__img" src="${l.image}" alt="" width="64" height="64" loading="lazy" />
            <div>
              <div class="cart-line__name">${escapeHtml(l.name)}</div>
              ${opts ? `<div class="cart-line__opts">${escapeHtml(opts)}</div>` : ''}
              <div class="cart-line__qty">
                <button data-dec="${key}" aria-label="Decrease quantity">–</button>
                <span>${l.qty}</span>
                <button data-inc="${key}" aria-label="Increase quantity">+</button>
              </div>
            </div>
            <div>
              <div class="cart-line__price">${usd(l.price * l.qty)}</div>
              <button class="cart-line__remove" data-remove="${key}">Remove</button>
            </div>
          </div>`;
      })
      .join('');

    if (subtotalEl) subtotalEl.textContent = usd(cartSubtotal());
  }

  function escapeHtml(s) {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }

  function mailtoFallback() {
    const lines = getCart();
    const list = lines
      .map((l) => `- ${l.name}${[l.size, l.color].filter(Boolean).length ? ` (${[l.size, l.color].filter(Boolean).join(', ')})` : ''} ×${l.qty}`)
      .join('%0D%0A');
    const body = `Hi Saucy Fields,%0D%0A%0D%0AI'd like to order:%0D%0A${list}%0D%0A%0D%0AName:%0D%0AShipping address / pickup:`;
    return `mailto:${email}?subject=${encodeURIComponent('Merch order')}&body=${body}`;
  }

  async function checkout() {
    if (!checkoutBtn) return;
    checkoutBtn.setAttribute('disabled', '');
    checkoutBtn.textContent = 'Taking you to checkout…';
    fallbackEl?.setAttribute('hidden', '');
    try {
      const res = await fetch('/api/checkout', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          items: getCart().map((l) => ({ slug: l.slug, size: l.size, color: l.color, qty: l.qty })),
        }),
      });
      if (res.ok) {
        const data = await res.json();
        if (data.url) { window.location.href = data.url; return; }
        throw new Error('No checkout URL');
      }
      // Not live yet, or a validation problem — offer the email path.
      const data = await res.json().catch(() => ({}));
      showFallback(data.message);
    } catch {
      showFallback();
    } finally {
      checkoutBtn.removeAttribute('disabled');
      checkoutBtn.textContent = 'Checkout';
    }
  }

  function showFallback(message) {
    if (!fallbackEl) return;
    const link = mailtoFallback();
    fallbackEl.innerHTML = `${escapeHtml(message || 'Online checkout isn’t switched on yet.')} <a href="${link}">Email your order instead →</a>`;
    fallbackEl.removeAttribute('hidden');
  }

  document.addEventListener('click', (e) => {
    const t = e.target;
    if (!(t instanceof HTMLElement)) return;
    if (t.closest('[data-open-cart]')) { e.preventDefault(); open(); }
    if (t.closest('[data-close-cart]')) close();
    if (t.dataset.inc) { const l = getCart().find((x) => lineKey(x) === t.dataset.inc); if (l) setQty(t.dataset.inc, l.qty + 1); }
    if (t.dataset.dec) { const l = getCart().find((x) => lineKey(x) === t.dataset.dec); if (l) setQty(t.dataset.dec, l.qty - 1); }
    if (t.dataset.remove) removeLine(t.dataset.remove);
    if (t.closest('[data-clear-cart]')) clearCart();
    if (t.closest('[data-checkout]')) checkout();
  });

  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  window.addEventListener('saucy:open-cart', open);
  onCartChange(render);
  render();
</script>
