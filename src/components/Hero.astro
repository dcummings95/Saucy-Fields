---
import { webpSrcset } from '../lib/img';
import { splitHeadline } from '../lib/headline';

/**
 * Full-bleed photo hero with a poster-style headline and up to two buttons.
 * Used by the homepage and by any page whose "Top of the page" is the banner.
 * The last word of the headline knocks out in the accent colour.
 *
 * The eyebrow always sits at the top. `position` moves the headline, subtext
 * and buttons as one group: top / middle / bottom, or 'spread' (headline at
 * the top, buttons pinned to the bottom, the original homepage layout).
 */
export type HeroTextPosition = 'spread' | 'top' | 'middle' | 'bottom';

interface Cta {
  label?: string | null;
  href?: string | null;
}
interface Props {
  image?: string | null;
  imageMobile?: string | null;
  alt?: string | null;
  eyebrow?: string | null;
  headline: string;
  subtext?: string | null;
  primary?: Cta | null;
  secondary?: Cta | null;
  position?: HeroTextPosition | null;
}

const { image, imageMobile, alt, eyebrow, headline, subtext, primary, secondary, position } = Astro.props;
const pos: HeroTextPosition = position ?? 'spread';

const { lead, last } = splitHeadline(headline);

// WebP variants only exist after `astro build` (see src/lib/img.ts).
const webp = image ? webpSrcset(image) : '';
const mobileWebp = imageMobile ? webpSrcset(imageMobile) : '';

const showPrimary = !!(primary?.label && primary?.href);
const showSecondary = !!(secondary?.label && secondary?.href);
---

<section class={`hero hero--${pos}`}>
  {
    image && (
      <picture class="hero__pic">
        {imageMobile && (
          <>
            {mobileWebp && (
              <source media="(max-width: 640px)" type="image/webp" srcset={mobileWebp} width="900" height="1124" />
            )}
            <source media="(max-width: 640px)" srcset={imageMobile} width="900" height="1124" />
          </>
        )}
        {webp && <source type="image/webp" srcset={webp} sizes="100vw" />}
        <img
          class="hero__img"
          src={image}
          alt={alt ?? ''}
          width="1672"
          height="941"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    )
  }
  <div class="hero__scrim" aria-hidden="true"></div>
  <div class="hero__inner">
    {eyebrow && <span class="eyebrow hero__eyebrow">{eyebrow}</span>}
    <div class="hero__body">
      <h1 class="hero__title">
        {lead} {last && <span class="hero__accent">{last}</span>}
      </h1>
      {subtext && <p class="hero__sub">{subtext}</p>}
      {
        (showPrimary || showSecondary) && (
          <div class="hero__cta">
            {showPrimary && (
              <a class="btn btn--primary" href={primary!.href}>
                {primary!.label}
              </a>
            )}
            {showSecondary && (
              <a class="btn hero__btn" href={secondary!.href}>
                {secondary!.label}
              </a>
            )}
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero { position: relative; border-bottom: 2.5px solid var(--ink); isolation: isolate; overflow: hidden; }
  .hero__pic { display: contents; }
  .hero__img {
    width: 100%;
    height: clamp(460px, 72vh, 660px);
    object-fit: cover;
    object-position: 50% 82%;
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgba(23, 21, 18, 0.22) 0%,
      rgba(23, 21, 18, 0.04) 34%,
      rgba(23, 21, 18, 0) 55%,
      rgba(23, 21, 18, 0.4) 100%
    );
  }
  .hero__inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(1.5rem, 4vw, 2.75rem);
  }
  /* Everything under the eyebrow. Fills the leftover height so the group can
     sit at the top, middle or bottom of it. */
  .hero__body {
    flex: 1;
    min-height: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero--middle .hero__body { justify-content: center; }
  .hero--bottom .hero__body { justify-content: flex-end; }
  /* With text in the middle, darken the centre a little too. */
  .hero--middle .hero__scrim {
    background:
      radial-gradient(ellipse 70% 45% at 50% 52%, rgba(23, 21, 18, 0.28), rgba(23, 21, 18, 0) 100%),
      linear-gradient(to bottom, rgba(23, 21, 18, 0.22) 0%, rgba(23, 21, 18, 0) 30%, rgba(23, 21, 18, 0) 75%, rgba(23, 21, 18, 0.25) 100%);
  }
  .hero__eyebrow {
    margin: 0 0 clamp(1rem, 3vw, 1.75rem);
    background: var(--mustard);
    color: var(--ink);
    border: var(--border);
    box-shadow: var(--shadow-sm);
  }
  .hero__title {
    margin: 0;
    width: min(100%, 60rem);
    max-width: 100%;
    font-size: clamp(1.9rem, 5.0vw, 5.0rem);
    color: var(--paper);
    -webkit-text-stroke: clamp(1.5px, 0.32vw, 3.5px) var(--ink);
    paint-order: stroke fill;
    /* hard poster offset + tight dark outline-halo so the near-white type
       stays legible over any part of the photo (WCAG 1.4.3) */
    text-shadow:
      4px 4px 0 var(--ink),
      0 0 3px rgba(23, 21, 18, 0.95),
      0 0 3px rgba(23, 21, 18, 0.95);
    text-wrap: balance;
    overflow-wrap: break-word;
  }
  .hero__accent { color: var(--saucy); }
  .hero__sub {
    margin: clamp(0.9rem, 2.5vw, 1.4rem) 0 0;
    max-width: 46ch;
    padding: 0.55rem 0.9rem;
    background: var(--paper);
    color: var(--ink);
    border: var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    font-weight: 500;
    text-wrap: pretty;
  }
  .hero__cta {
    margin-top: clamp(1rem, 3vw, 1.5rem);
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    justify-content: center;
  }
  /* 'spread': buttons pinned to the bottom, away from the headline. */
  .hero--spread .hero__cta { margin-top: auto; padding-top: 1rem; }
  .hero__btn { background: var(--paper); }

  @media (max-width: 640px) {
    .hero__img { height: clamp(480px, 82vh, 600px); object-position: 50% 62%; }
    .hero__inner { padding: 1.4rem 1.15rem; }
    .hero__eyebrow {
      margin-bottom: 1.1rem;
      font-size: 0.6rem;
      letter-spacing: 0.06em;
      padding: 0.3rem 0.55rem;
      transform: rotate(-1deg);
    }
    .hero__title {
      font-size: clamp(1.7rem, 7vw, 2.8rem);
      max-width: 15ch;
      text-shadow:
        3px 3px 0 var(--ink),
        0 0 3px rgba(23, 21, 18, 0.95),
        0 0 3px rgba(23, 21, 18, 0.95);
    }
    .hero__sub { font-size: 0.92rem; }
    .hero__cta { flex-direction: column; align-items: center; }
    .hero__cta .btn { width: min(20rem, 100%); justify-content: center; }
  }
</style>
