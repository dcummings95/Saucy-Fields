---
import CmsImage from './CmsImage.astro';

/**
 * Text beside a framed photo, the layout from the top of the About page.
 * The text goes in the default slot. Used for the "split" hero on Extra pages
 * and for the "Text + photo" section block. Stacks text-first on narrow screens.
 */
interface Props {
  image?: string | null;
  alt?: string | null;
  side?: 'left' | 'right';
  /** True when this is the first thing on the page (loads the photo eagerly). */
  priority?: boolean;
}
const { image, alt, side = 'right', priority = false } = Astro.props;
---

<div class:list={['split', { 'split--photo-left': side === 'left', 'split--no-photo': !image }]}>
  <div class="split__text">
    <slot />
  </div>
  {
    image && (
      <figure class="split__photo panel">
        <CmsImage
          src={image}
          alt={alt ?? ''}
          width={1500}
          height={1125}
          sizes="(max-width: 820px) 92vw, 520px"
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : undefined}
        />
      </figure>
    )
  }
</div>

<style>
  .split {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(1.5rem, 5vw, 3rem);
    align-items: center;
  }
  .split--photo-left { grid-template-columns: 1fr 1.2fr; }
  .split--photo-left .split__photo { order: -1; }
  .split--no-photo { grid-template-columns: 1fr; }
  .split__text { min-width: 0; }
  .split__photo { overflow: hidden; margin: 0; }
  /* <img> comes from <CmsImage> (its own scope) — reach it with :global. */
  .split__photo :global(img) { width: 100%; height: auto; display: block; }

  @media (max-width: 820px) {
    .split,
    .split--photo-left { grid-template-columns: 1fr; }
    .split--photo-left .split__photo { order: 0; }
  }
</style>
