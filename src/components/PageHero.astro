---
import Hero, { type HeroTextPosition } from './Hero.astro';
import SplitFeature from './SplitFeature.astro';
import { splitHeadline } from '../lib/headline';

/**
 * The top of a page, as picked in Keystatic's "Top of the page" field
 * (`heroPicker` in keystatic.config.ts). Renders nothing for "none": each page
 * keeps its own plain heading for that case, since they all lay it out a
 * little differently.
 *
 * Headline, subtext and eyebrow come from the hero when it has its own text
 * (Extra pages), otherwise from the page's heading / intro / label passed in.
 */
interface Cta {
  label?: string | null;
  href?: string | null;
}
interface HeroFields {
  image?: string | null;
  imageMobile?: string | null;
  imageAlt?: string | null;
  photoSide?: 'left' | 'right';
  textPosition?: HeroTextPosition;
  eyebrow?: string | null;
  headline?: string | null;
  subtext?: string | null;
  primaryCta?: Cta | null;
  secondaryCta?: Cta | null;
}
export type HeroValue = { discriminant: 'none'; value?: unknown } | { discriminant: 'full' | 'split'; value: HeroFields };

interface Props {
  hero: HeroValue;
  title: string;
  subtext?: string | null;
  eyebrow?: string | null;
  /** Used as the main button when the hero sets no buttons of its own. */
  fallbackCta?: Cta | null;
}

const { hero, title, subtext: pageSubtext, eyebrow: pageEyebrow, fallbackCta } = Astro.props;

const h = hero.discriminant === 'none' ? null : hero.value;
const headline = h?.headline?.trim() || title;
const subtext = h?.subtext?.trim() || pageSubtext || null;
const eyebrow = h?.eyebrow?.trim() || pageEyebrow || null;

const has = (c?: Cta | null) => !!(c?.label && c?.href);
const ownButtons = has(h?.primaryCta) || has(h?.secondaryCta);
const primary = ownButtons ? h?.primaryCta : fallbackCta;
const secondary = ownButtons ? h?.secondaryCta : null;

const { lead, last } = splitHeadline(headline);
const buttons = [
  { cta: primary, cls: 'btn btn--primary' },
  { cta: secondary, cls: 'btn' },
].filter((b) => has(b.cta));
---

{
  hero.discriminant === 'full' && h && (
    <Hero
      image={h.image}
      imageMobile={h.imageMobile}
      alt={h.imageAlt}
      eyebrow={eyebrow}
      headline={headline}
      subtext={subtext}
      primary={primary}
      secondary={secondary}
      position={h.textPosition}
    />
  )
}
{
  hero.discriminant === 'split' && h && (
    <section class="page-hero">
      <div class="wrap">
        <SplitFeature image={h.image} alt={h.imageAlt} side={h.photoSide} priority>
          {eyebrow && <span class="eyebrow">{eyebrow}</span>}
          <h1 class="page-hero__title">
            {lead} {last && <span class="page-hero__accent">{last}</span>}
          </h1>
          {subtext && <p class="page-hero__sub">{subtext}</p>}
          {buttons.length > 0 && (
            <div class="page-hero__cta">
              {buttons.map((b) => (
                <a class={b.cls} href={b.cta!.href}>
                  {b.cta!.label}
                </a>
              ))}
            </div>
          )}
        </SplitFeature>
      </div>
    </section>
  )
}

<style>
  /* A solid band with a rule under it, like the full banner, so the split hero
     reads as the top of the page rather than one more "Text + photo" section. */
  .page-hero {
    background: var(--paper-2);
    border-bottom: var(--border);
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  .page-hero__title { margin: 0; text-wrap: balance; }
  .page-hero__accent { color: var(--saucy); }
  .page-hero__sub { margin: 1rem 0 0; max-width: 46ch; font-size: 1.15rem; text-wrap: pretty; }
  .page-hero__cta { margin-top: 1.6rem; display: flex; flex-wrap: wrap; gap: 0.8rem; }
  /* Slight poster tilt on the photo; the figure lives in <SplitFeature>. */
  .page-hero :global(.split__photo) { transform: rotate(1.2deg); }
  .page-hero :global(.split--photo-left .split__photo) { transform: rotate(-1.2deg); }

  @media (max-width: 820px) {
    .page-hero :global(.split__photo) { margin-top: 0.5rem; }
  }
</style>
