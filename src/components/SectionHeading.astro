---
interface Props {
  eyebrow?: string;
  title: string;
  as?: 'h1' | 'h2';
}
const { eyebrow, title, as: Tag = 'h2' } = Astro.props;
---

<div class="sh">
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <Tag class="sh__title">{title}</Tag>
  <slot />
</div>

<style>
  .sh { margin-bottom: clamp(1.5rem, 4vw, 2.5rem); }
  .sh__title { margin-top: 0; margin-bottom: 0; }
  .sh :global(p) { margin-top: 0.75rem; max-width: 55ch; }
</style>
