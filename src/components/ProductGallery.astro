---
interface Props {
  images: { src: string; alt: string }[];
  name: string;
}
const { images, name } = Astro.props;
const gallery = images.length ? images : [{ src: '', alt: name }];
---

<div class="gallery" data-gallery>
  <div class="gallery__main panel">
    {
      gallery[0].src ? (
        <img data-gallery-main src={gallery[0].src} alt={gallery[0].alt} width="1000" height="1250" />
      ) : (
        <div class="gallery__empty">No photo yet</div>
      )
    }
  </div>
  {
    gallery.length > 1 && (
      <ul class="gallery__thumbs">
        {gallery.map((img, i) => (
          <li>
            <button
              class:list={['gallery__thumb', { 'is-active': i === 0 }]}
              data-gallery-thumb
              data-src={img.src}
              data-alt={img.alt}
              aria-label={`View image ${i + 1}`}
            >
              <img src={img.src} alt="" width="120" height="150" loading="lazy" />
            </button>
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>
  .gallery__main { overflow: hidden; aspect-ratio: 4 / 5; background: var(--paper-2); }
  .gallery__main img { width: 100%; height: 100%; object-fit: cover; }
  .gallery__empty { display: grid; place-items: center; height: 100%; font-family: var(--font-display); opacity: 0.5; }

  .gallery__thumbs {
    list-style: none;
    display: flex;
    gap: 0.6rem;
    padding: 0;
    margin: 0.8rem 0 0;
    flex-wrap: wrap;
  }
  .gallery__thumb {
    width: 66px;
    height: 82px;
    padding: 0;
    border: 2.5px solid var(--ink);
    border-radius: 4px;
    overflow: hidden;
    cursor: pointer;
    background: var(--paper-2);
  }
  .gallery__thumb img { width: 100%; height: 100%; object-fit: cover; }
  .gallery__thumb.is-active { outline: 3px solid var(--saucy); outline-offset: 1px; }
</style>

<script>
  document.querySelectorAll('[data-gallery]').forEach((root) => {
    const main = root.querySelector('[data-gallery-main]');
    const thumbs = root.querySelectorAll('[data-gallery-thumb]');
    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        if (!(main instanceof HTMLImageElement) || !(thumb instanceof HTMLElement)) return;
        main.src = thumb.dataset.src ?? main.src;
        main.alt = thumb.dataset.alt ?? main.alt;
        thumbs.forEach((t) => t.classList.remove('is-active'));
        thumb.classList.add('is-active');
      });
    });
  });
</script>
