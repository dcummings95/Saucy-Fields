---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PageSections from '../components/PageSections.astro';
import { getPages, getPage } from '../lib/keystatic';
import { renderMarkdoc } from '../lib/markdoc';

export async function getStaticPaths() {
  // Slugs that clash with built-in routes (src/lib/reserved-slugs.ts) are
  // refused by the slug field's validation, both in the editor and by the
  // reader at build time, so every entry here is safe to route.
  const pages = await getPages();
  return pages.map((p) => ({ params: { page: p.slug } }));
}

const { page } = Astro.params;
const entry = await getPage(page!);
if (!entry) return Astro.redirect('/');

const html = renderMarkdoc(entry.contentNode);
const hasHero = entry.hero.discriminant !== 'none';
const heroSubtext = entry.hero.discriminant === 'none' ? null : entry.hero.value.subtext;
---

<Base title={entry.title} description={entry.description || heroSubtext || undefined}>
  <PageHero hero={entry.hero} title={entry.title} />
  {
    (!hasHero || html) && (
      <section class="section wrap page">
        {!hasHero && <h1>{entry.title}</h1>}
        {html && <div class="prose" set:html={html} />}
      </section>
    )
  }
  <PageSections sections={entry.sections} />
</Base>

<style>
  .page { max-width: 68ch; }
  .page h1 { margin-bottom: 1.5rem; }
</style>
