---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProductCard from '../components/ProductCard.astro';
import { getHomepage, getProducts } from '../lib/keystatic';
import { slugify } from '../lib/slug';

const home = await getHomepage();
const products = await getProducts();
const featured = products.filter((p) => p.featured);
const featuredList = [...featured, ...products.filter((p) => !featured.includes(p))].slice(0, 4);

// Bands we've actually printed merch for — their name links to the filtered shop.
const bandSlugsWithMerch = new Set(products.filter((p) => p.band).map((p) => slugify(p.band!)));

// Hero headline: knock the last word out in the accent colour.
const heroWords = home.heroHeadline.trim().split(/\s+/);
const heroLast = heroWords.length > 1 ? heroWords.pop()! : '';
const heroLead = heroWords.join(' ');
---

<Base description={home.heroSubtext}>
  <section class="hero">
    {
      home.heroImage && (
        <picture class="hero__pic">
          {home.heroImageMobile && (
            <source media="(max-width: 640px)" srcset={home.heroImageMobile} width="900" height="1124" />
          )}
          <img
            class="hero__img"
            src={home.heroImage}
            alt={home.heroImageAlt}
            width="1672"
            height="941"
            fetchpriority="high"
          />
        </picture>
      )
    }
    <div class="hero__scrim" aria-hidden="true"></div>
    <div class="hero__inner">
      <span class="eyebrow hero__eyebrow">Winona, MN · screen-print shop</span>
      <h1 class="hero__title">
        {heroLead} <span class="hero__accent">{heroLast}</span>
      </h1>
      <div class="hero__cta">
        <a class="btn btn--primary" href={home.primaryCta.href}>{home.primaryCta.label}</a>
        <a class="btn hero__btn" href={home.secondaryCta.href}>{home.secondaryCta.label}</a>
      </div>
    </div>
  </section>

  <section class="section--tight wrap">
    <div class="marquee" aria-hidden="true">
      <div class="marquee__track">
        {
          Array.from({ length: 2 }).map(() => (
            <span class="marquee__group">
              {Array.from({ length: 4 }).map(() => (
                <span>Shirts&nbsp;✦&nbsp;Posters&nbsp;✦&nbsp;Album art&nbsp;✦&nbsp;Show flyers&nbsp;✦&nbsp;Merch tables&nbsp;✦&nbsp;</span>
              ))}
            </span>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section wrap">
    <SectionHeading eyebrow="From the shop" title="Fresh off the press" />
    <div class="grid">
      {featuredList.map((p, i) => <ProductCard product={p} index={i} />)}
    </div>
    <p class="more"><a class="btn" href="/shop">See everything in the shop →</a></p>
  </section>

  <section class="section section-invert">
    <div class="wrap">
      <SectionHeading eyebrow="What we do" title={home.whatWeDoHeading} />
      <div class="what">
        {
          home.whatWeDo.map((item, i) => (
            <div class="what__item panel" style={`--tilt:${(i % 2 ? 1 : -1) * 0.7}deg`}>
              <span class="what__num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section wrap">
    <SectionHeading eyebrow="Good company" title={home.bandsHeading} />
    <ul class="bands">
      {
        home.bands.map((b) => {
          const slug = slugify(b.name);
          if (bandSlugsWithMerch.has(slug)) {
            return (
              <li>
                <a href={`/shop?band=${slug}`}>{b.name}</a>
              </li>
            );
          }
          if (b.url) {
            return (
              <li>
                <a href={b.url} target="_blank" rel="noopener">{b.name}</a>
              </li>
            );
          }
          return <li>{b.name}</li>;
        })
      }
    </ul>
    <div class="cta panel">
      <h2>In a band? Let's make your merch.</h2>
      <p>Art, print, and delivery handled — so you show up to the show with a full table.</p>
      <a class="btn btn--mustard" href="/services">How it works →</a>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; border-bottom: 2.5px solid var(--ink); isolation: isolate; overflow: hidden; }
  .hero__pic { display: contents; }
  .hero__img {
    width: 100%;
    height: clamp(460px, 72vh, 660px);
    object-fit: cover;
    object-position: 50% 82%;
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgba(23, 21, 18, 0.22) 0%,
      rgba(23, 21, 18, 0.04) 34%,
      rgba(23, 21, 18, 0) 55%,
      rgba(23, 21, 18, 0.4) 100%
    );
  }
  .hero__inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(1.5rem, 4vw, 2.75rem);
  }
  .hero__eyebrow {
    margin: 0 0 clamp(1rem, 3vw, 1.75rem);
    background: var(--mustard);
    color: var(--ink);
    border: var(--border);
    box-shadow: var(--shadow-sm);
  }
  .hero__title {
    margin: 0;
    width: min(100%, 60rem);
    max-width: 100%;
    font-size: clamp(1.9rem, 5.0vw, 5.0rem);
    color: var(--paper);
    -webkit-text-stroke: clamp(1.5px, 0.32vw, 3.5px) var(--ink);
    paint-order: stroke fill;
    /* hard poster offset + tight dark outline-halo so the near-white type
       stays legible over any part of the photo (WCAG 1.4.3) */
    text-shadow:
      4px 4px 0 var(--ink),
      0 0 3px rgba(23, 21, 18, 0.95),
      0 0 3px rgba(23, 21, 18, 0.95);
    text-wrap: balance;
    overflow-wrap: break-word;
  }
  .hero__accent { color: var(--saucy); }
  .hero__cta {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    justify-content: center;
  }
  .hero__btn { background: var(--paper); }

  .marquee {
    overflow: hidden;
    border-block: 2.5px solid var(--ink);
    padding-block: 0.6rem;
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    background: var(--mustard);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 45s linear infinite;
  }
  .marquee__group {
    display: flex;
    flex-shrink: 0;
    white-space: nowrap;
  }
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee__track { animation: none; }
  }

  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1rem, 3vw, 1.8rem); align-items: start; }
  .more { margin-top: 2rem; }

  .what { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; }
  .what__item { padding: 1.4rem; transform: rotate(var(--tilt)); color: var(--ink); }
  .what__num { font-family: var(--font-display); font-weight: 800; font-size: 1.6rem; color: var(--saucy); }
  .what__item h3 { margin: 0.3rem 0 0.5rem; }
  .what__item p { margin: 0; }

  .bands { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.8rem; font-family: var(--font-display); font-weight: 700; }
  .bands li { border: 2.5px solid var(--ink); border-radius: 999px; padding: 0.4rem 1rem; background: var(--paper); overflow: hidden; }
  .bands a { text-decoration: none; color: var(--ink); display: block; margin: -0.4rem -1rem; padding: 0.4rem 1rem; }
  .bands a:hover { background: var(--mustard); color: var(--ink); }

  .cta { margin-top: 2.5rem; padding: clamp(1.5rem, 5vw, 3rem); text-align: center; background: var(--saucy); color: var(--paper); }
  .cta h2 { margin-bottom: 0.5rem; }
  .cta p { max-width: 40ch; margin-inline: auto; margin-bottom: 1.3rem; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
    .what { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .hero__img { height: clamp(480px, 82vh, 600px); object-position: 50% 62%; }
    .hero__inner { padding: 1.4rem 1.15rem; }
    .hero__eyebrow {
      margin-bottom: 1.1rem;
      font-size: 0.6rem;
      letter-spacing: 0.06em;
      padding: 0.3rem 0.55rem;
      transform: rotate(-1deg);
    }
    .hero__title {
      font-size: clamp(1.7rem, 7vw, 2.8rem);
      max-width: 15ch;
      text-shadow:
        3px 3px 0 var(--ink),
        0 0 3px rgba(23, 21, 18, 0.95),
        0 0 3px rgba(23, 21, 18, 0.95);
    }
    .hero__cta { flex-direction: column; align-items: center; }
    .hero__cta .btn { width: min(20rem, 100%); justify-content: center; }
  }
  @media (max-width: 480px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
