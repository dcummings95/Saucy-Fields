---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { getAbout, getSiteSettings } from '../lib/keystatic';
import { renderMarkdoc } from '../lib/markdoc';
import CmsImage from '../components/CmsImage.astro';
import PageHero from '../components/PageHero.astro';
import InstagramPosts from '../components/InstagramPosts.astro';

const about = await getAbout();
const settings = await getSiteSettings();
const storyHtml = renderMarkdoc(about.storyNode);
const hasHero = about.hero.discriminant !== 'none';
---

<Base title="About" description={about.intro}>
  <PageHero hero={about.hero} title={about.heading} subtext={about.intro} eyebrow={about.eyebrow} />

  {
    (!hasHero || storyHtml) && (
      <section class="section wrap">
        {!hasHero && (
          <SectionHeading eyebrow={about.eyebrow || undefined} title={about.heading} as="h1">
            <p>{about.intro}</p>
          </SectionHeading>
        )}
        {storyHtml && <div class="prose" set:html={storyHtml} />}
      </section>
    )
  }

  {
    about.founders.length > 0 && (
      <section class="section section-invert">
        <div class="wrap">
          <SectionHeading eyebrow="The two of us" title="Isaac & Spencer" />
          <div class="founders">
            {about.founders.map((f) => (
              <div class:list={['founder panel', { 'founder--photo': f.photo }]}>
                {f.photo && (
                  <div class="founder__photo">
                    <CmsImage src={f.photo} alt={f.name} width={600} height={774} sizes="(max-width: 820px) 32vw, 180px" />
                  </div>
                )}
                <div class="founder__body">
                  <h3>{f.name}</h3>
                  <p class="founder__role">{f.role}</p>
                  <p>{f.bio}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <InstagramPosts
    posts={about.posts}
    eyebrow={about.postsEyebrow}
    heading={about.postsHeading}
    profileUrl={settings.social.instagram}
    shape="photo"
    badge="Instagram"
  />

  {
    about.process.length > 0 && (
      <section class="section wrap">
        <SectionHeading eyebrow="The work" title={about.processHeading} />
        <ol class="process">
          {about.process.map((step, i) => (
            <li class="process__step">
              <span class="process__num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{step.step}</h3>
              <p>{step.detail}</p>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <section class="section--tight wrap">
    <div class="here panel">
      <h2>You'll find us in {settings.location.city}</h2>
      <p>{settings.location.blurb}</p>
      <a class="btn btn--primary" href="/contact">Get in touch →</a>
    </div>
  </section>
</Base>

<style>
  .founders { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .founder { display: grid; color: var(--ink); overflow: hidden; }
  /* Photo runs the full height of the card down the left edge. */
  .founder--photo { grid-template-columns: minmax(7rem, 32%) 1fr; }
  .founder__photo { position: relative; border-right: var(--border); background: var(--paper-2); }
  .founder__photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }
  .founder__body { padding: 1.3rem; }
  .founder__role { font-family: var(--font-display); font-weight: 700; color: var(--saucy-dark); margin: 0.1rem 0 0.5rem; }
  .founder h3 { margin: 0; }
  .founder p:last-child { margin-bottom: 0; }

  .process { list-style: none; counter-reset: step; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.4rem; }
  .process__step { border: var(--border); border-radius: var(--radius); box-shadow: var(--shadow-sm); padding: 1.3rem; }
  .process__num { font-family: var(--font-display); font-weight: 800; font-size: 1.5rem; color: var(--saucy); }
  .process__step h3 { margin: 0.2rem 0 0.4rem; }
  .process__step p { margin: 0; }

  .here { padding: clamp(1.5rem, 5vw, 3rem); text-align: center; background: var(--mustard); }
  .here p { max-width: 44ch; margin-inline: auto; margin-bottom: 1.2rem; }

  @media (max-width: 820px) {
    .founders { grid-template-columns: 1fr; }
    .process { grid-template-columns: 1fr; }
  }
</style>
