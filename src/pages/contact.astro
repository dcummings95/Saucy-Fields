---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PageHero from '../components/PageHero.astro';
import { getContactPage, getSiteSettings } from '../lib/keystatic';

const settings = await getSiteSettings();
const contact = await getContactPage();
const social = [
  { label: 'Instagram', href: settings.social.instagram },
  { label: 'TikTok', href: settings.social.tiktok },
  { label: 'Facebook', href: settings.social.facebook },
].filter((s) => s.href);

// Keep `value`s in sync with TOPICS in src/pages/api/contact.ts.
// Linking to /contact?topic=merch preselects that option.
const TOPICS = [
  { value: 'question', label: 'A question, or something else', messageLabel: "What's up?", placeholder: '' },
  {
    value: 'merch',
    label: 'Making merch with us',
    messageLabel: 'Tell us about it',
    placeholder: 'What are you making, about how many, and when do you need them? Mention any art you already have.',
  },
  { value: 'order', label: 'An order I placed', messageLabel: "What's up?", placeholder: 'Which order, and what do you need?' },
];
---

<Base title="Contact" description={`Get in touch with Saucy Fields in ${settings.location.city}, ${settings.location.region}.`}>
  <PageHero hero={contact.hero} title={contact.heading} subtext={contact.intro} eyebrow={contact.eyebrow} />
  <section class="section wrap contact">
    <div>
      {
        contact.hero.discriminant === 'none' && (
          <SectionHeading eyebrow={contact.eyebrow || undefined} title={contact.heading} as="h1">
            {contact.intro && <p>{contact.intro}</p>}
          </SectionHeading>
        )
      }

      <dl class="contact__list">
        <dt>Email</dt>
        <dd><a href={`mailto:${settings.email}`}>{settings.email}</a></dd>
        <dt>Where</dt>
        <dd>{settings.location.city}, {settings.location.region}</dd>
        <dt>Socials</dt>
        <dd class="contact__social">
          {social.map((s) => <a href={s.href} target="_blank" rel="me noopener">{s.label}</a>)}
        </dd>
      </dl>
      <p class="contact__note">{settings.shippingNote}</p>
    </div>

    <div class="contact__form panel">
      <p class="contact__thanks" data-thanks hidden>
        Thanks! We got your message and will get back to you soon.
      </p>
      <p class="contact__error" data-error hidden></p>
      <form
        name="contact"
        method="POST"
        action="/api/contact"
        data-contact-form
      >
        <p class="contact__hp" aria-hidden="true">
          <label>Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>
        <label>
          <span>Your name</span>
          <input type="text" name="name" required />
        </label>
        <label>
          <span>Email</span>
          <input type="email" name="email" required />
        </label>
        <label>
          <span>What's this about?</span>
          <select name="topic" data-topic>
            {
              TOPICS.map((t) => (
                <option value={t.value} data-label={t.messageLabel} data-placeholder={t.placeholder}>
                  {t.label}
                </option>
              ))
            }
          </select>
        </label>
        <label>
          <span data-message-label>{TOPICS[0].messageLabel}</span>
          <textarea name="message" rows="5" required placeholder={TOPICS[0].placeholder}></textarea>
        </label>
        <button type="submit" class="btn btn--primary btn--block">Send it</button>
      </form>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const thanks = document.querySelector<HTMLElement>('[data-thanks]');
  const errorBox = document.querySelector<HTMLElement>('[data-error]');

  const showThanks = () => {
    form?.setAttribute('hidden', '');
    errorBox?.setAttribute('hidden', '');
    thanks?.removeAttribute('hidden');
  };
  const showError = (msg: string) => {
    if (!errorBox) return;
    errorBox.textContent = msg;
    errorBox.removeAttribute('hidden');
  };

  // Topic picker: preselect from ?topic= and retitle the message box to match.
  const topicEl = document.querySelector<HTMLSelectElement>('[data-topic]');
  const messageLabel = document.querySelector<HTMLElement>('[data-message-label]');
  const messageEl = document.querySelector<HTMLTextAreaElement>('textarea[name="message"]');
  const syncTopic = () => {
    const opt = topicEl?.selectedOptions[0];
    if (!opt) return;
    if (messageLabel) messageLabel.textContent = opt.dataset.label ?? "What's up?";
    if (messageEl) messageEl.placeholder = opt.dataset.placeholder ?? '';
  };
  topicEl?.addEventListener('change', syncTopic);

  // No-JS submit posts straight to /api/contact, which 303s back here.
  const params = new URLSearchParams(location.search);
  const wanted = params.get('topic');
  if (topicEl && wanted && [...topicEl.options].some((o) => o.value === wanted)) topicEl.value = wanted;
  syncTopic();
  if (params.get('sent') === '1') showThanks();
  if (params.get('error') === '1') showError('Something went wrong. Please try again or email us directly.');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const button = form.querySelector('button[type="submit"]');
    button?.setAttribute('disabled', '');
    errorBox?.setAttribute('hidden', '');

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok) {
        showThanks();
      } else {
        showError(data.message || 'Something went wrong. Please try again or email us directly.');
        button?.removeAttribute('disabled');
      }
    } catch {
      showError('Could not reach the server. Please try again or email us directly.');
      button?.removeAttribute('disabled');
    }
  });
</script>

<style>
  .contact { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.5rem, 5vw, 3.5rem); align-items: start; }

  .contact__list { display: grid; grid-template-columns: auto 1fr; gap: 0.5rem 1.2rem; margin: 1.5rem 0; }
  .contact__list dt { font-family: var(--font-display); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.8rem; padding-top: 0.15rem; }
  .contact__list dd { margin: 0; }
  .contact__social { display: flex; gap: 1rem; flex-wrap: wrap; }
  .contact__note { font-size: 0.9rem; opacity: 0.75; max-width: 40ch; }

  .contact__form { padding: clamp(1.3rem, 4vw, 2rem); }
  .contact__form form { display: grid; gap: 1rem; }
  .contact__form label { display: grid; gap: 0.3rem; }
  .contact__form label > span { font-family: var(--font-display); font-weight: 700; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.06em; }
  .contact__form input,
  .contact__form select,
  .contact__form textarea { font: inherit; padding: 0.6rem 0.7rem; border: var(--border); border-radius: var(--radius); background: var(--paper); width: 100%; }
  .contact__hp { position: absolute; left: -5000px; }
  .contact__thanks { font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; }
  .contact__error {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--saucy-dark);
    border: 2px dashed var(--saucy-dark);
    border-radius: var(--radius);
    padding: 0.6rem 0.8rem;
    margin: 0 0 1rem;
  }

  @media (max-width: 800px) { .contact { grid-template-columns: 1fr; } }
</style>
