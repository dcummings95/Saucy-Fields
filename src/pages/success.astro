---
import Base from '../layouts/Base.astro';
---

<Base title="Order confirmed" description="Thanks for your order.">
  <section class="section wrap outcome">
    <span class="eyebrow">Order confirmed</span>
    <h1>Thanks — you're a legend.</h1>
    <p>
      We got your order and a receipt is on its way to your email. Screen-printed goods ship in small
      batches; pre-sale items go out once the run is done. Questions? <a href="/contact">Get in touch.</a>
    </p>
    <a class="btn btn--primary" href="/shop">Keep browsing →</a>
  </section>
</Base>

<script>
  // Clear the cart once Stripe has redirected the buyer back here.
  import { clearCart } from '../lib/cart';
  clearCart();
</script>

<style>
  .outcome { max-width: 52ch; text-align: center; margin-inline: auto; padding-block: clamp(3rem, 10vw, 6rem); }
  .outcome p { margin-block: 1.2rem 1.8rem; }
</style>
